# Portable runtime config (all relative paths resolved from package root)
RUNTIME_BACKEND_DIR=runtime\backend
RUNTIME_FRONTEND_DIR=build
RUNTIME_MODELS_DIR=models
RUNTIME_ROUTING_DIR=runtime\routing
RUNTIME_DATA_DIR=data\geo
RUNTIME_DEM_DIR=data\geo\dem
RUNTIME_LOGS_DIR=logs
RUNTIME_CACHE_DIR=cache

LLAMA_SERVER_EXE=runtime\llama.cpp\llama-server.exe
LLAMA_MODEL_PATH=models\model.gguf
OLLAMA_EXE=runtime\ollama\ollama.exe

BACKEND_CMD=runtime\backend\start_backend.bat
BACKEND_URL=http://localhost:8080
BACKEND_HEALTH_URL=http://localhost:8080/health

VALHALLA_CMD=runtime\routing\start_valhalla.bat
VALHALLA_HEALTH_URL=http://127.0.0.1:8002/status
GEO_HEALTH_URL=http://localhost:8080/api/geo/health

BROWSER_URL=http://localhost:8080/maps
